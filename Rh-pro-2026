<script>
(function(){
  "use strict";

  // ---------- Proteção contra cópia (total) ----------
  ['copy','cut','paste','contextmenu','selectstart'].forEach(function(evt){
    document.addEventListener(evt, function(e){ e.preventDefault(); return false; }, false);
  });
  document.addEventListener('keydown', function(e){
    var tag = (e.target && e.target.tagName) ? e.target.tagName.toUpperCase() : '';
    var isInput = (tag==='INPUT' || tag==='TEXTAREA');
    var k = (e.key||'').toLowerCase();
    var ctrlOrCmd = e.ctrlKey || e.metaKey;
    if(ctrlOrCmd && !isInput && (k==='c' || k==='x' || k==='u' || k==='s' || k==='p' || k==='a')){
      e.preventDefault();
    }
  }, false);

  function fmt(n){ if(isNaN(n)) n=0; return n.toLocaleString('de-DE',{minimumFractionDigits:2,maximumFractionDigits:2}); }
  function parseNum(str){
    if(typeof str !== 'string') return Number(str)||0;
    var cleaned = str.replace(/[^\d,.-]/g,'').replace(/\./g,'').replace(',', '.');
    var v = parseFloat(cleaned);
    return isNaN(v) ? 0 : v;
  }
  function round2(n){ return Math.round((n||0)*100)/100; }

  // Escalões de IRT 2026 (isento até 70.000 Kz; usada tanto na folha como no validador)
  function calcIRT(mc){
    if(mc<=0) return 0;
    if(mc<=70000) return 0;
    if(mc<=100000) return (mc-70000)*0.10;
    if(mc<=150000) return 3000 + (mc-100000)*0.13;
    if(mc<=200000) return 9500 + (mc-150000)*0.16;
    return 17500 + (mc-200000)*0.20;
  }

  var HORAS_MES = 176, DIAS_MES = 22;
  var NUMERIC = ['vhora','vdia','bruto','subAlim','subSaude','subTransp','subFerias','subNatal','descFalta','faltasJust','extra'];
  var nextId = 1;
  var rows = [];
  var folhaFechada = false;

  function blankRow(){
    return {id: nextId++, matricula:'', nome:'', nif:'', departamento:'', cargo:'', vhora:0, vdia:0, bruto:0,
      subAlim:0, subSaude:0, subTransp:0, subFerias:0, subNatal:0, descFalta:0, faltasJust:0, extra:0};
  }
  function seedRows(n){ rows=[]; for(var i=0;i<n;i++) rows.push(blankRow()); }
  function seedDemoData(){
    seedRows(0);
    var demo = [
      ['0001','Ana Kiala','003456789LA045','Financeiro','Contabilista',2200,0],
      ['0002','João Bumba','004512378LA012','Comercial','Gestor de Vendas',0,18000],
      ['0003','Marta Sanjambo','002233445LA078','RH','Técnica de RH',1900,0],
      ['0004','Pedro Chindongo','005678123LA090','Operações','Supervisor de Armazém',0,16500],
      ['0005','Isabel Neto','001987654LA033','Financeiro','Assistente Administrativa',1600,0]
    ];
    demo.forEach(function(d){
      var r = blankRow();
      r.matricula=d[0]; r.nome=d[1]; r.nif=d[2]; r.departamento=d[3]; r.cargo=d[4]; r.vhora=d[5]; r.vdia=d[6];
      rows.push(r);
    });
  }

  function isBrutoAuto(r){ return (r.vhora||0) > 0 || (r.vdia||0) > 0; }
  function syncBruto(r){
    if(isBrutoAuto(r)){ r.bruto = round2((r.vhora||0)*HORAS_MES + (r.vdia||0)*DIAS_MES); return true; }
    return false;
  }
  function computeRow(r){
    var totalGanhos = (r.bruto||0) + (r.extra||0) - (r.descFalta||0);
    if(totalGanhos < 0) totalGanhos = 0;
    var inss = totalGanhos * 0.03;
    var mc = totalGanhos - inss;
    if(mc < 0) mc = 0;
    var irt = calcIRT(mc);
    var liquido = (r.bruto||0)+(r.subAlim||0)+(r.subSaude||0)+(r.subTransp||0)+(r.subFerias||0)+(r.subNatal||0)+
                  (r.extra||0) - (r.descFalta||0) - inss - irt;
    return {inss:inss, mc:mc, irt:irt, liquido:liquido};
  }

  var tbody = document.getElementById('tbody');
  var deptSelect = document.getElementById('filter-dept');

  function refreshDeptOptions(){
    var current = deptSelect.value || 'Todos';
    var depts = [];
    rows.forEach(function(r){ var d=(r.departamento||'').trim(); if(d && depts.indexOf(d)===-1) depts.push(d); });
    depts.sort(function(a,b){ return a.localeCompare(b); });
    deptSelect.innerHTML = '<option value="Todos">Todos os departamentos</option>' +
      depts.map(function(d){ return '<option value="'+escapeAttr(d)+'">'+escapeAttr(d)+'</option>'; }).join('');
    deptSelect.value = depts.indexOf(current)!==-1 || current==='Todos' ? current : 'Todos';
  }
  function getVisibleRows(){
    var f = deptSelect.value || 'Todos';
    if(f==='Todos') return rows;
    return rows.filter(function(r){ return (r.departamento||'').trim()===f; });
  }

  function render(){
    refreshDeptOptions();
    var visible = getVisibleRows();
    tbody.innerHTML = '';
    visible.forEach(function(r, idx){
      var auto = syncBruto(r);
      var c = computeRow(r);
      var tr = document.createElement('tr');
      tr.setAttribute('data-id', r.id);
      tr.innerHTML =
        '<td class="col-n">'+(idx+1)+'</td>' +
        td_text('matricula', r.matricula) +
        td_text('nome', r.nome) +
        td_text('nif', r.nif) +
        td_text('departamento', r.departamento) +
        td_text('cargo', r.cargo) +
        td_num('vhora', r.vhora) +
        td_num('vdia', r.vdia) +
        (auto
          ? '<td><input class="num-input" type="text" data-field="bruto" readonly value="'+fmt(r.bruto)+'" '+dis()+'></td>'
          : td_num('bruto', r.bruto)) +
        td_num('subAlim', r.subAlim) +
        td_num('subSaude', r.subSaude) +
        td_num('subTransp', r.subTransp) +
        td_num('subFerias', r.subFerias) +
        td_num('subNatal', r.subNatal) +
        td_num('descFalta', r.descFalta) +
        td_num('faltasJust', r.faltasJust) +
        td_num('extra', r.extra) +
        '<td><input class="num-input" type="text" data-field="inss" readonly value="'+fmt(c.inss)+'"></td>' +
        '<td><input class="num-input" type="text" data-field="mc" readonly value="'+fmt(c.mc)+'"></td>' +
        '<td><input class="num-input" type="text" data-field="irt" readonly value="'+fmt(c.irt)+'"></td>' +
        '<td><input class="num-input" type="text" data-field="liquido" readonly value="'+fmt(c.liquido)+'"></td>' +
        '<td class="col-del"><button class="del-btn" data-del="'+r.id+'" title="Remover" '+dis()+'>✕</button></td>';
      tbody.appendChild(tr);
    });
    renderTotals(visible);
    applyLockState();
  }
  function dis(){ return folhaFechada ? 'disabled' : ''; }
  function td_text(field, val){ return '<td><input type="text" data-field="'+field+'" value="'+escapeAttr(val)+'" placeholder="—" '+dis()+'></td>'; }
  function td_num(field, val){ return '<td><input class="num-input" type="text" data-field="'+field+'" value="'+fmt(val||0)+'" '+dis()+'></td>'; }
  function escapeAttr(s){ return (s||'').toString().replace(/&/g,'&amp;').replace(/"/g,'&quot;'); }

  function renderTotals(visible){
    var somaBruto=0, somaInss=0, somaIrt=0, somaLiquido=0;
    visible.forEach(function(r){ syncBruto(r); var c=computeRow(r); somaBruto+=(r.bruto||0); somaInss+=c.inss; somaIrt+=c.irt; somaLiquido+=c.liquido; });
    document.querySelector('.soma-bruto').textContent = fmt(somaBruto);
    document.querySelector('.soma-inss').textContent = fmt(somaInss);
    document.querySelector('.soma-irt').textContent = fmt(somaIrt);
    document.querySelector('.soma-liquido').textContent = fmt(somaLiquido);
    document.getElementById('kpi-bruto').textContent = fmt(somaBruto);
    document.getElementById('kpi-inss').textContent = fmt(somaInss);
    document.getElementById('kpi-irt').textContent = fmt(somaIrt);
    document.getElementById('kpi-liquido').textContent = fmt(somaLiquido);
  }

  function updateRowCells(tr, row){
    var brutoInput = tr.querySelector('[data-field="bruto"]');
    var auto = isBrutoAuto(row);
    syncBruto(row);
    if(brutoInput){
      if(auto){ brutoInput.readOnly = true; brutoInput.value = fmt(row.bruto); }
      else { brutoInput.readOnly = false; }
    }
    var c = computeRow(row);
    tr.querySelector('[data-field="inss"]').value = fmt(c.inss);
    tr.querySelector('[data-field="mc"]').value = fmt(c.mc);
    tr.querySelector('[data-field="irt"]').value = fmt(c.irt);
    tr.querySelector('[data-field="liquido"]').value = fmt(c.liquido);
  }

  function applyLockState(){
    var badge = document.getElementById('status-badge');
    var lockBtn = document.getElementById('btn-lock');
    document.getElementById('meta-empresa').disabled = folhaFechada;
    document.getElementById('meta-mes').disabled = folhaFechada;
    document.getElementById('btn-add-row').disabled = folhaFechada;
    document.getElementById('btn-clear').disabled = folhaFechada;
    if(folhaFechada){ badge.textContent='Fechada'; badge.className='status-badge status-closed'; lockBtn.innerHTML='🔓 Reabrir Folha'; }
    else { badge.textContent='Em Aberto'; badge.className='status-badge status-open'; lockBtn.innerHTML='🔒 Fechar Folha'; }
  }

  tbody.addEventListener('input', function(e){
    if(folhaFechada) return;
    var input = e.target;
    var field = input.getAttribute('data-field');
    if(!field || ['inss','mc','irt','liquido'].indexOf(field)!==-1) return;
    var tr = input.closest('tr');
    var id = parseInt(tr.getAttribute('data-id'),10);
    var row = rows.find(function(r){return r.id===id;});
    if(!row) return;
    row[field] = NUMERIC.indexOf(field)!==-1 ? parseNum(input.value) : input.value;
    updateRowCells(tr, row);
    renderTotals(getVisibleRows());
    if(field==='departamento') refreshDeptOptions();
    scheduleSave();
  });
  tbody.addEventListener('focusout', function(e){
    var input = e.target;
    var field = input.getAttribute('data-field');
    if(field && NUMERIC.indexOf(field)!==-1 && !input.readOnly){ input.value = fmt(parseNum(input.value)); }
  });
  tbody.addEventListener('click', function(e){
    if(folhaFechada) return;
    var btn = e.target.closest('[data-del]');
    if(!btn) return;
    var id = parseInt(btn.getAttribute('data-del'),10);
    if(rows.length<=1){ alert('É necessário manter pelo menos uma linha na folha.'); return; }
    if(!confirm('Remover este funcionário da folha?')) return;
    rows = rows.filter(function(r){return r.id!==id;});
    render(); scheduleSave();
  });
  deptSelect.addEventListener('change', function(){ render(); });

  document.getElementById('btn-add-row').addEventListener('click', function(){
    if(folhaFechada) return;
    rows.push(blankRow()); render(); scheduleSave();
    var lastRow = tbody.querySelector('tr:last-child input');
    if(lastRow) lastRow.focus();
  });
  document.getElementById('btn-clear').addEventListener('click', function(){
    if(folhaFechada) return;
    if(!confirm('Isto vai limpar todos os dados da folha (mantendo 12 linhas em branco). Continuar?')) return;
    seedRows(12); render();
    document.getElementById('meta-empresa').value='';
    document.getElementById('meta-mes').value='';
    scheduleSave();
  });
  document.getElementById('btn-lock').addEventListener('click', function(){
    if(folhaFechada){ folhaFechada = false; }
    else{ if(!confirm('Fechar a folha vai bloquear a edição de todos os campos até a reabrir. Continuar?')) return; folhaFechada = true; }
    render(); scheduleSave();
  });

  // ---------- CSV ----------
  document.getElementById('btn-csv').addEventListener('click', function(){
    var headers = ['Nº','Matrícula','Nome','NIF','Departamento','Cargo','Valor/Hora','Valor/Dia','Bruto','Subs. Alimentação','Subs. Saúde','Subs. Transporte','Subs. Férias','Subs. Natal','Desc. Falta','Faltas Justificadas','Extra','INSS (3%)','MC','IRT','Líquido'];
    var lines = [headers.join(';')];
    rows.forEach(function(r, idx){
      syncBruto(r); var c = computeRow(r);
      lines.push([idx+1, csvSafe(r.matricula), csvSafe(r.nome), csvSafe(r.nif), csvSafe(r.departamento), csvSafe(r.cargo),
        numCsv(r.vhora), numCsv(r.vdia), numCsv(r.bruto), numCsv(r.subAlim), numCsv(r.subSaude), numCsv(r.subTransp),
        numCsv(r.subFerias), numCsv(r.subNatal), numCsv(r.descFalta), numCsv(r.faltasJust), numCsv(r.extra),
        numCsv(c.inss), numCsv(c.mc), numCsv(c.irt), numCsv(c.liquido)].join(';'));
    });
    downloadBlob(new Blob(['\uFEFF'+lines.join('\r\n')], {type:'text/csv;charset=utf-8;'}), fileName('csv'));
  });
  function csvSafe(s){ return '"' + (s||'').toString().replace(/"/g,'""') + '"'; }
  function numCsv(n){ return (n||0).toFixed(2).replace('.',','); }
  function fileName(ext){ var mes = document.getElementById('meta-mes').value || 'folha'; return 'folha_RH_'+mes+'.'+ext; }
  function downloadBlob(blob, name){
    var url = URL.createObjectURL(blob); var a=document.createElement('a'); a.href=url; a.download=name;
    document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);
  }

  // ---------- Excel ----------
  document.getElementById('btn-excel').addEventListener('click', function(){
    if(typeof XLSX === 'undefined'){ alert('Biblioteca Excel não carregou. Verifique a ligação à internet e tente novamente.'); return; }
    var headers = ['Nº','Matrícula','Nome','NIF','Departamento','Cargo','Valor/Hora','Valor/Dia','Bruto','Subs. Alimentação','Subs. Saúde','Subs. Transporte','Subs. Férias','Subs. Natal','Desc. Falta','Faltas Justificadas','Extra','INSS (3%)','MC','IRT','Líquido'];
    var aoa = [headers]; var somaBruto=0, somaInss=0, somaIrt=0, somaLiquido=0;
    rows.forEach(function(r, idx){
      syncBruto(r); var c = computeRow(r);
      somaBruto+=(r.bruto||0); somaInss+=c.inss; somaIrt+=c.irt; somaLiquido+=c.liquido;
      aoa.push([idx+1, r.matricula, r.nome, r.nif, r.departamento, r.cargo, r.vhora, r.vdia, r.bruto, r.subAlim, r.subSaude,
        r.subTransp, r.subFerias, r.subNatal, r.descFalta, r.faltasJust, r.extra, round2(c.inss), round2(c.mc), round2(c.irt), round2(c.liquido)]);
    });
    aoa.push([]);
    aoa.push(['','','','','','','','','Totais','','','','','','','','',round2(somaInss),'',round2(somaIrt),round2(somaLiquido)]);
    aoa.push(['Soma Bruto', round2(somaBruto)]);
    var ws = XLSX.utils.aoa_to_sheet(aoa);
    ws['!cols'] = headers.map(function(){ return {wch:13}; });
    var wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'Folha RH PRO');
    XLSX.writeFile(wb, fileName('xlsx'));
  });

  // ---------- PDF Oficial A3 com assinatura ----------
  document.getElementById('btn-pdf').addEventListener('click', function(){
    if(typeof window.jspdf === 'undefined'){ alert('Biblioteca PDF não carregou. Verifique a ligação à internet e tente novamente.'); return; }
    var doc = new window.jspdf.jsPDF({orientation:'landscape', unit:'pt', format:'a3'});
    var empresa = document.getElementById('meta-empresa').value || 'Empresa';
    var mes = document.getElementById('meta-mes').value || '—';
    var status = folhaFechada ? 'FECHADA' : 'EM ABERTO';
    doc.setFont('helvetica','bold'); doc.setFontSize(17);
    doc.text('Folha Salarial Oficial — ' + empresa, 40, 40);
    doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(90);
    doc.text('Recursos Humanos  ·  Mês de referência: ' + mes + '  ·  Angola 2026  ·  Estado: ' + status, 40, 58);

    var headers = ['Nº','Matrícula','Nome','NIF','Depart.','Cargo','V.Hora','V.Dia','Bruto','Alim.','Saúde','Transp.','Férias','Natal','Desc.Falta','F.Justif.','Extra','INSS 3%','MC','IRT','Líquido'];
    var body = []; var somaBruto=0, somaInss=0, somaIrt=0, somaLiquido=0;
    rows.forEach(function(r, idx){
      syncBruto(r); var c = computeRow(r);
      somaBruto+=(r.bruto||0); somaInss+=c.inss; somaIrt+=c.irt; somaLiquido+=c.liquido;
      body.push([idx+1, r.matricula||'—', r.nome||'—', r.nif||'—', r.departamento||'—', r.cargo||'—', fmt(r.vhora), fmt(r.vdia),
        fmt(r.bruto), fmt(r.subAlim), fmt(r.subSaude), fmt(r.subTransp), fmt(r.subFerias), fmt(r.subNatal), fmt(r.descFalta),
        fmt(r.faltasJust), fmt(r.extra), fmt(c.inss), fmt(c.mc), fmt(c.irt), fmt(c.liquido)]);
    });
    doc.autoTable({
      head:[headers], body:body, startY:72,
      styles:{fontSize:7.5, cellPadding:3}, headStyles:{fillColor:[26,31,54], textColor:[247,248,251]},
      foot:[['','','','','','','','Totais:', fmt(somaBruto),'','','','','','','','','INSS: '+fmt(somaInss),'','IRT: '+fmt(somaIrt),'Líq.: '+fmt(somaLiquido)]],
      footStyles:{fillColor:[241,242,247], textColor:[123,44,191], fontStyle:'bold'},
      theme:'grid'
    });
    var finalY = (doc.lastAutoTable && doc.lastAutoTable.finalY) ? doc.lastAutoTable.finalY : 400;
    var sigY = finalY + 60;
    doc.setDrawColor(140); doc.setLineWidth(0.7);
    doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(60);
    doc.line(40, sigY, 320, sigY); doc.text('Responsável de Recursos Humanos', 40, sigY+14);
    doc.line(400, sigY, 680, sigY); doc.text('Data: ____ / ____ / ________', 400, sigY+14);
    doc.line(760, sigY, 1040, sigY); doc.text('Carimbo da Empresa', 760, sigY+14);
    doc.save(fileName('pdf'));
  });

  // ---------- Tabs ----------
  document.querySelectorAll('.tab-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.tab-btn').forEach(function(b){b.classList.remove('active');});
      document.querySelectorAll('.tab-panel').forEach(function(p){p.classList.remove('active');});
      btn.classList.add('active');
      document.getElementById('panel-'+btn.getAttribute('data-tab')).classList.add('active');
    });
  });

  // ---------- Individual calculator ----------
  var cpBruto = document.getElementById('cp-bruto');
  var cpInss = document.getElementById('cp-inss');
  var cpIrt = document.getElementById('cp-irt');
  function renderCP(){
    var bruto = parseNum(cpBruto.value);
    var taxaInss = parseNum(cpInss.value);
    var taxaIrt = parseNum(cpIrt.value);
    var inss = bruto * (taxaInss/100);
    var irt = bruto * (taxaIrt/100);
    var liquido = bruto - inss - irt;
    document.getElementById('cp-out-bruto').textContent = fmt(bruto)+' Kz';
    document.getElementById('cp-out-inss').textContent = fmt(inss)+' Kz';
    document.getElementById('cp-out-irt').textContent = fmt(irt)+' Kz';
    document.getElementById('cp-out-liquido').textContent = fmt(liquido)+' Kz';
  }
  [cpBruto, cpInss, cpIrt].forEach(function(el){
    el.addEventListener('input', renderCP);
    el.addEventListener('focusout', function(){ el.value = fmt(parseNum(el.value)); renderCP(); });
  });

  // ---------- Persistence (localStorage real) ----------
  var STORAGE_KEY = 'folha_final_venda_15k';
  var saveTimer = null;
  var saveDot = document.getElementById('save-dot');
  var saveText = document.getElementById('save-text');
  var storageAvailable = false;
  try{ var tk='__folha_test__'; localStorage.setItem(tk,'1'); localStorage.removeItem(tk); storageAvailable = true; }catch(err){ storageAvailable = false; }

  function scheduleSave(){
    if(!storageAvailable) return;
    if(saveTimer) clearTimeout(saveTimer);
    saveDot.classList.add('saving'); saveText.textContent = 'a guardar…';
    saveTimer = setTimeout(doSave, 600);
  }
  function doSave(){
    try{
      var payload = { rows: rows, nextId: nextId, folhaFechada: folhaFechada,
        empresa: document.getElementById('meta-empresa').value, mes: document.getElementById('meta-mes').value };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      saveDot.classList.remove('saving'); saveText.textContent = 'dados guardados';
    }catch(err){ saveDot.classList.remove('saving'); saveText.textContent = 'não foi possível guardar'; }
  }
  function loadSaved(){
    if(!storageAvailable){ seedDemoData(); render(); saveText.textContent = 'modo local (sem gravação)'; return; }
    try{
      var raw = localStorage.getItem(STORAGE_KEY);
      if(raw){
        var payload = JSON.parse(raw);
        if(payload && payload.rows && payload.rows.length){
          rows = payload.rows; nextId = payload.nextId || (rows.length+1); folhaFechada = !!payload.folhaFechada;
          document.getElementById('meta-empresa').value = payload.empresa || '';
          document.getElementById('meta-mes').value = payload.mes || '';
        } else { seedDemoData(); }
      } else { seedDemoData(); }
      render(); saveText.textContent = 'dados guardados';
    }catch(err){ seedDemoData(); render(); saveText.textContent = 'não foi possível ler dados guardados'; }
  }
  document.getElementById('meta-empresa').addEventListener('input', scheduleSave);
  document.getElementById('meta-mes').addEventListener('input', scheduleSave);

  // ---------- Validador 0% Erro ----------
  var btnValidar = document.getElementById('btn-validar');
  var validatorBox = document.getElementById('validator-box');
  var vTitle = document.getElementById('v-title');
  var vSub = document.getElementById('v-sub');
  var vDetail = document.getElementById('v-detail');
  var vClose = document.getElementById('v-close');

  function validarFolha(){
    var trs = document.querySelectorAll('#tbody tr');
    var totalLinhas = trs.length;
    var erros = [];

    trs.forEach(function(tr, idx){
      var brutoInput = tr.querySelector('[data-field="bruto"]');
      var inssInput = tr.querySelector('[data-field="inss"]');
      var irtInput = tr.querySelector('[data-field="irt"]');
      var liquidoInput = tr.querySelector('[data-field="liquido"]');
      var nomeInput = tr.querySelector('[data-field="nome"]');
      if(!brutoInput || !inssInput || !irtInput || !liquidoInput){ return; }

      var bruto = parseNum(brutoInput.value);
      var inssAtual = parseNum(inssInput.value);
      var irtAtual = parseNum(irtInput.value);
      var liquidoAtual = parseNum(liquidoInput.value);

      var inssEsperado = Math.round(bruto * 0.03);
      var mc = bruto - inssEsperado;
      var irtEsperado = calcIRT(mc);
      var liquidoEsperado = bruto - inssEsperado - irtEsperado;

      var diffInss = Math.abs(inssAtual - inssEsperado);
      var diffIrt = Math.abs(irtAtual - irtEsperado);
      var diffLiquido = Math.abs(liquidoAtual - liquidoEsperado);

      if(diffInss > 10 || diffIrt > 10 || diffLiquido > 10){
        erros.push({
          linha: idx+1,
          nome: (nomeInput && nomeInput.value) ? nomeInput.value : ('Linha ' + (idx+1)),
          diffInss: diffInss, diffIrt: diffIrt, diffLiquido: diffLiquido
        });
        tr.style.outline = '2px solid #ff4d6d';
        tr.style.outlineOffset = '-1px';
      } else {
        tr.style.outline = '';
        tr.style.outlineOffset = '';
      }
    });

    mostrarResultadoValidador(totalLinhas, erros);
  }

  function mostrarResultadoValidador(totalLinhas, erros){
    var pctErro = totalLinhas > 0 ? Math.round((erros.length / totalLinhas) * 100) : 0;
    validatorBox.style.display = 'block';
    if(erros.length === 0){
      validatorBox.className = 'ok';
      vTitle.textContent = '✅ Validação concluída — 0% erro';
      vSub.textContent = totalLinhas + ' de ' + totalLinhas + ' linhas corretas.';
      vDetail.innerHTML = '';
    } else {
      validatorBox.className = 'erro';
      vTitle.textContent = '⚠️ ' + pctErro + '% de erro';
      vSub.textContent = erros.length + ' de ' + totalLinhas + ' linha(s) com diferença > 10 Kz.';
      vDetail.innerHTML = erros.map(function(e){
        return '<div>L' + e.linha + ' — ' + escapeAttr(e.nome) + '<br>ΔINSS:' + fmt(e.diffInss) + ' ΔIRT:' + fmt(e.diffIrt) + ' ΔLíq:' + fmt(e.diffLiquido) + '</div>';
      }).join('');
    }
  }

  if(btnValidar) btnValidar.addEventListener('click', validarFolha);
  if(vClose) vClose.addEventListener('click', function(){ validatorBox.style.display = 'none'; });

  loadSaved();
  renderCP();
})();
</script>
</body>
</html>

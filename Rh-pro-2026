    --teal:#0abf8a; --purple:#7b2cbf;
    --text:#1a1f36; --muted:#6b7280; --line:#e6e8f0;
    --danger:#e0435c;
    --radius:14px;
    --shadow:0 10px 30px rgba(16,24,40,0.07);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{background:var(--bg); color:var(--text); font-family:'Manrope',system-ui,sans-serif; -webkit-font-smoothing:antialiased;
    user-select:none; -webkit-user-select:none; -moz-user-select:none; -ms-user-select:none;}
  input, textarea{user-select:text; -webkit-user-select:text; -moz-user-select:text; -ms-user-select:text;}
  ::selection{background:rgba(10,191,138,0.22); color:var(--text);}
  h1,h2,h3{font-family:'Space Grotesk',sans-serif; margin:0;}
  .num{font-family:'IBM Plex Mono',monospace; font-variant-numeric:tabular-nums;}
  .wrap{max-width:1200px; margin:0 auto; padding:0 24px;}
  a{text-decoration:none;}

  /* ---------- Barra de venda ---------- */
  .salesbar{position:sticky; top:0; z-index:50; background:linear-gradient(120deg,var(--teal),var(--purple)); color:#fff; box-shadow:0 4px 18px rgba(10,20,40,0.12);}
  .salesbar-inner{max-width:1200px; margin:0 auto; padding:14px 24px; display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap;}
  .salesbar .logo{font-family:'Space Grotesk'; font-weight:800; font-size:16.5px; display:flex; align-items:center; gap:9px;}
  .salesbar .logo .dot{width:9px; height:9px; border-radius:50%; background:#fff; box-shadow:0 0 10px rgba(255,255,255,0.9);}
  .salesbar .cta-group{display:flex; gap:10px; align-items:center;}
  .btn-cta{font-family:'Manrope'; font-weight:800; font-size:13.5px; padding:10px 18px; border-radius:10px; cursor:pointer; border:none; display:inline-flex; align-items:center; gap:7px; transition:transform .1s ease, box-shadow .15s ease;}
  .btn-cta:active{transform:translateY(1px);}
  .btn-buy{background:#fff; color:#1a1f36;}
  .btn-buy:hover{box-shadow:0 6px 18px rgba(0,0,0,0.18);}
  .btn-ghost-light{background:rgba(255,255,255,0.16); color:#fff; border:1px solid rgba(255,255,255,0.5) !important;}
  .btn-ghost-light:hover{background:rgba(255,255,255,0.26);}

  /* ---------- Hero ---------- */
  .hero{padding:24px 0 40px;}
  .hero-grid{display:grid; grid-template-columns:1.05fr 0.95fr; gap:48px; align-items:start;}
  @media (max-width:900px){ .hero-grid{grid-template-columns:1fr;} }
  .eyebrow{display:inline-flex; align-items:center; gap:7px; font-size:12px; font-weight:700; letter-spacing:.05em; text-transform:uppercase;
    color:var(--purple); background:rgba(123,44,191,0.08); border:1px solid rgba(123,44,191,0.18); padding:6px 12px; border-radius:20px; margin-bottom:10px;}
  .hero h1{font-size:40px; line-height:1.14; letter-spacing:-.01em;}
  .hero h1 .grad{background:linear-gradient(120deg,var(--teal),var(--purple)); -webkit-background-clip:text; background-clip:text; color:transparent;}
  .hero p.lead{font-size:16.5px; color:var(--muted); margin:18px 0 28px; max-width:520px; line-height:1.6;}
  .hero-ctas{display:flex; gap:12px; flex-wrap:wrap; margin-bottom:26px;}
  .btn-lg{font-family:'Manrope'; font-weight:800; font-size:14.5px; padding:14px 24px; border-radius:12px; cursor:pointer; border:none; display:inline-flex; align-items:center; gap:8px;}
  .btn-lg-solid{background:linear-gradient(120deg,var(--teal),var(--purple)); color:#fff; box-shadow:0 10px 26px rgba(123,44,191,0.28);}
  .btn-lg-solid:hover{box-shadow:0 14px 32px rgba(123,44,191,0.36);}
  .btn-lg-outline{background:#fff; color:var(--text); border:1.5px solid var(--line) !important;}
  .btn-lg-outline:hover{border-color:var(--purple) !important;}
  .trust-row{display:flex; gap:22px; flex-wrap:wrap; font-size:13px; color:var(--muted);}
  .trust-row span{display:flex; align-items:center; gap:6px;}
  .trust-row b{color:var(--text);}

  /* Hero mockup graphic */
  .hero-visual{position:relative;}
  .hero-visual svg{width:100%; height:auto; display:block;}
  .float-badge{position:absolute; bottom:-16px; left:26px; background:#fff; border-radius:12px; box-shadow:var(--shadow); border:1px solid var(--line);
    padding:10px 16px; font-size:12px; font-weight:700; display:flex; align-items:center; gap:8px;}
  .float-badge .ic{width:26px; height:26px; border-radius:50%; background:rgba(10,191,138,0.12); color:var(--teal); display:flex; align-items:center; justify-content:center; font-size:13px;}

  /* ---------- O que recebes ---------- */
  .section{padding:56px 0;}
  .section-head{text-align:center; max-width:640px; margin:0 auto 34px;}
  .section-head h2{font-size:28px; letter-spacing:-.01em;}
  .section-head p{color:var(--muted); margin-top:10px; font-size:14.5px;}
  .benefits-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:18px;}
  @media (max-width:820px){ .benefits-grid{grid-template-columns:1fr 1fr;} }
  @media (max-width:560px){ .benefits-grid{grid-template-columns:1fr;} }
  .benefit-card{background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); padding:20px; box-shadow:var(--shadow);}
  .benefit-card .ic{width:38px; height:38px; border-radius:10px; background:linear-gradient(120deg,rgba(10,191,138,0.15),rgba(123,44,191,0.15));
    display:flex; align-items:center; justify-content:center; font-size:17px; margin-bottom:12px;}
  .benefit-card h3{font-size:15px; margin-bottom:6px;}
  .benefit-card p{font-size:13px; color:var(--muted); line-height:1.55; margin:0;}
  .buy-banner{margin-top:36px; background:linear-gradient(120deg,var(--teal),var(--purple)); border-radius:18px; padding:26px 30px;
    display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; color:#fff;}
  .buy-banner .price{font-family:'Space Grotesk'; font-weight:800; font-size:15px;}
  .buy-banner .price b{font-size:22px;}

  /* ---------- Demo (app) ---------- */
  .demo-section{background:var(--panel-2); border-top:1px solid var(--line); border-bottom:1px solid var(--line); padding:52px 0 64px;}
  .demo-label{display:inline-flex; align-items:center; gap:7px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.05em;
    color:var(--teal); background:rgba(10,191,138,0.08); border:1px solid rgba(10,191,138,0.2); padding:6px 12px; border-radius:20px; margin-bottom:14px;}

  .app-topbar{background:var(--panel); border:1px solid var(--line); border-radius:16px; padding:22px 26px 18px; margin-bottom:20px; box-shadow:var(--shadow); position:relative;}
  .app-topbar-row{display:flex; align-items:center; justify-content:space-between; gap:18px; flex-wrap:wrap; margin-bottom:16px;}
  .brand{display:flex; align-items:center; gap:12px;}
  .seal{width:40px; height:40px; border-radius:12px; background:linear-gradient(120deg,var(--teal),var(--purple)); color:#fff;
    display:flex; align-items:center; justify-content:center; font-family:'Space Grotesk'; font-weight:800; font-size:12px; flex:none;}
  .brand h1{font-size:18px;}
  .brand p{margin:2px 0 0; font-size:12px; color:var(--muted);}
  .status-badge{font-family:'Space Grotesk'; font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.05em;
    padding:4px 10px; border-radius:20px; border:1px solid; margin-left:8px; vertical-align:middle;}
  .status-open{color:var(--teal); border-color:rgba(10,191,138,0.4); background:rgba(10,191,138,0.08);}
  .status-closed{color:var(--danger); border-color:rgba(224,67,92,0.4); background:rgba(224,67,92,0.08);}
  .meta-fields{display:flex; gap:10px; flex-wrap:wrap;}
  .meta-fields label{display:flex; flex-direction:column; gap:4px; font-size:10.5px; color:var(--muted); text-transform:uppercase; letter-spacing:.05em;}
  .meta-fields input{background:var(--panel-2); border:1px solid var(--line); color:var(--text); border-radius:8px; padding:7px 10px; font-size:13px; font-family:'Manrope'; min-width:150px;}
  .meta-fields input:focus{outline:none; border-color:var(--teal);}
  .meta-fields input:disabled{opacity:.5; cursor:not-allowed;}

  .kpi-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:10px;}
  @media (max-width:760px){ .kpi-grid{grid-template-columns:repeat(2,1fr);} }
  .kpi-card{background:var(--panel-2); border:1px solid var(--line); border-radius:10px; padding:12px 14px;}
  .kpi-card .kpi-label{font-size:10px; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); font-family:'Space Grotesk'; font-weight:700;}
  .kpi-card .kpi-value{font-family:'IBM Plex Mono'; font-size:17px; font-weight:700; margin-top:4px; color:var(--text);}
  .kpi-card.k-teal .kpi-value{color:var(--teal);}
  .kpi-card.k-purple .kpi-value{color:var(--purple);}

  .tabs{display:flex; gap:6px; margin-bottom:16px; border-bottom:1px solid var(--line);}
  .tab-btn{background:none; border:none; padding:10px 18px; font-family:'Space Grotesk'; font-size:14px; font-weight:600; color:var(--muted); cursor:pointer; border-bottom:3px solid transparent; margin-bottom:-1px;}
  .tab-btn.active{color:var(--text); border-bottom-color:var(--teal);}
  .tab-panel{display:none;}
  .tab-panel.active{display:block;}

  .toolbar{display:flex; flex-wrap:wrap; gap:10px; margin-bottom:14px; align-items:center; justify-content:space-between;}
  .toolbar-group{display:flex; gap:8px; flex-wrap:wrap; align-items:center;}
  .btn{font-family:'Manrope'; font-weight:700; font-size:12.5px; cursor:pointer; border-radius:9px; padding:9px 14px; border:1px solid var(--line);
    display:inline-flex; align-items:center; gap:7px; background:var(--panel); color:var(--text); transition:box-shadow .15s ease, border-color .15s ease;}
  .btn:hover:not(:disabled){border-color:var(--teal); box-shadow:0 4px 14px rgba(10,191,138,0.14);}
  .btn:disabled{opacity:.4; cursor:not-allowed;}
  .btn-teal{color:var(--teal); border-color:rgba(10,191,138,0.4);}
  .btn-purple{color:var(--purple); border-color:rgba(123,44,191,0.4);}
  .btn-danger{color:var(--danger); border-color:rgba(224,67,92,0.4);}
  .btn-solid{background:linear-gradient(120deg,var(--teal),var(--purple)); color:#fff; border:none;}
  .btn-solid:hover:not(:disabled){box-shadow:0 8px 22px rgba(123,44,191,0.28);}
  .select-dept{background:var(--panel); border:1px solid var(--line); color:var(--text); border-radius:9px; padding:9px 12px; font-family:'Manrope'; font-size:13px; font-weight:600;}
  .save-indicator{font-size:12px; color:var(--muted); display:flex; align-items:center; gap:6px;}
  .save-dot{width:7px; height:7px; border-radius:50%; background:var(--teal); transition:background .3s;}
  .save-dot.saving{background:var(--purple);}

  .table-wrap{background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); overflow-x:auto; margin-bottom:16px; box-shadow:var(--shadow);}
  table{border-collapse:collapse; width:100%; min-width:2500px;}
  thead th{background:var(--panel-2); color:var(--muted); font-family:'Space Grotesk'; font-weight:700; font-size:10.5px; text-transform:uppercase;
    letter-spacing:.03em; padding:10px 7px; text-align:left; border-bottom:1px solid var(--line); white-space:nowrap; position:sticky; top:0;}
  thead th.grp-auto{color:var(--purple);}
  tbody td{padding:5px; border-bottom:1px solid var(--line); vertical-align:middle;}
  tbody tr:hover{background:#fafbff;}
  tbody input{width:100%; border:1px solid transparent; background:transparent; border-radius:6px; padding:6px; font-size:12.5px; font-family:'Manrope'; color:var(--text);}
  tbody input.num-input{font-family:'IBM Plex Mono'; text-align:right;}
  tbody input:hover{border-color:var(--line);}
  tbody input:focus{outline:none; border-color:var(--teal); box-shadow:0 0 0 3px rgba(10,191,138,0.12);}
  tbody input[readonly]{background:rgba(123,44,191,0.06); color:var(--purple); font-weight:700; cursor:default;}
  tbody input:disabled{opacity:.55; cursor:not-allowed;}
  .col-n{width:32px; text-align:center; color:var(--muted); font-family:'IBM Plex Mono'; font-size:12px;}
  .col-del{width:34px; text-align:center;}
  .del-btn{background:none; border:none; color:var(--danger); cursor:pointer; font-size:15px; padding:4px 6px; border-radius:6px;}
  .del-btn:hover:not(:disabled){background:rgba(224,67,92,0.1);}
  .del-btn:disabled{opacity:.3; cursor:not-allowed;}

  tfoot td{padding:12px 7px; font-family:'IBM Plex Mono'; font-weight:700; font-size:13px; background:var(--panel-2); border-top:1px solid var(--line); color:var(--purple); white-space:nowrap;}
  tfoot td.label{font-family:'Space Grotesk'; font-weight:700; text-transform:uppercase; font-size:10.5px; letter-spacing:.04em; color:var(--muted);}

  .hint{font-size:12.5px; color:var(--muted); margin:0 0 16px; line-height:1.6;}
  .hint b{color:var(--text);}
  .footer-note{font-size:12px; color:var(--muted); border-top:1px dashed var(--line); padding-top:14px; margin-top:6px; line-height:1.6;}

  .calc-wrap{display:grid; grid-template-columns:1fr 1fr; gap:20px;}
  @media (max-width:820px){ .calc-wrap{grid-template-columns:1fr;} }
  .card{background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); padding:22px; box-shadow:var(--shadow);}
  .card h2{font-size:16px; margin-bottom:4px;}
  .card .sub{font-size:12.5px; color:var(--muted); margin-bottom:18px;}
  .field{margin-bottom:14px;}
  .field label{display:block; font-size:11.5px; font-weight:700; color:var(--text); margin-bottom:6px; text-transform:uppercase; letter-spacing:.03em;}
  .field-row{display:flex; gap:10px;}
  .field-row .field{flex:1;}
  .field input{width:100%; border:1px solid var(--line); border-radius:8px; padding:10px 12px; font-family:'IBM Plex Mono'; font-size:15px; color:var(--text); background:var(--panel-2);}
  .field input:focus{outline:none; border-color:var(--teal);}
  .result-line{display:flex; justify-content:space-between; align-items:baseline; padding:11px 0; border-bottom:1px solid var(--line); font-size:14px;}
  .result-line:last-child{border-bottom:none;}
  .result-line .lbl{color:var(--muted);}
  .result-line .val{font-family:'IBM Plex Mono'; font-weight:700; color:var(--text);}
  .result-line.deduct .val{color:var(--danger);}
  .result-line.final{margin-top:6px; padding-top:16px; border-top:1px solid var(--line);}
  .result-line.final .lbl{color:var(--text); font-weight:700; font-family:'Space Grotesk'; text-transform:uppercase; font-size:12px; letter-spacing:.03em;}
  .result-line.final .val{font-size:20px; color:var(--teal);}
  .badge{display:inline-block; background:rgba(123,44,191,0.1); color:var(--purple); font-size:11px; font-weight:700; padding:3px 9px; border-radius:20px; margin-left:8px; vertical-align:middle; border:1px solid rgba(123,44,191,0.25);}

  footer.site-footer{padding:30px 0; text-align:center; color:var(--muted); font-size:12.5px;}

  /* ---------- Validador 0% Erro ---------- */
  #btn-validar{
    position:fixed; bottom:20px; left:20px; z-index:9000;
    font-family:'Manrope'; font-weight:800; font-size:13px; color:#fff; border:none; cursor:pointer;
    padding:13px 18px; border-radius:12px; background:linear-gradient(120deg,#0abf8a,#7b2cbf);
    box-shadow:0 10px 26px rgba(123,44,191,0.3); display:inline-flex; align-items:center; gap:7px;
  }
  #btn-validar:hover{box-shadow:0 14px 32px rgba(123,44,191,0.4);}
  #btn-validar:active{transform:translateY(1px);}
  #validator-box{
    position:fixed; bottom:20px; right:20px; z-index:9000; max-width:320px;
    background:#ffffff; border-radius:14px; box-shadow:0 16px 40px rgba(16,24,40,0.22);
    padding:16px 18px; display:none; font-family:'Manrope'; border-left:5px solid #8b8fa3;
  }
  #validator-box.ok{border-left-color:#0abf8a;}
  #validator-box.erro{border-left-color:#ff4d6d;}
  #validator-box .v-close{position:absolute; top:8px; right:10px; background:none; border:none; cursor:pointer; color:#9aa0ad; font-size:14px;}
  #validator-box .v-title{font-family:'Space Grotesk'; font-weight:800; font-size:14px; margin-bottom:4px; padding-right:16px;}
  #validator-box.ok .v-title{color:#0abf8a;}
  #validator-box.erro .v-title{color:#ff4d6d;}
  #validator-box .v-sub{font-size:12px; color:#6b7280; margin-bottom:8px;}
  #validator-box .v-detail{font-size:11.5px; color:#1a1f36; line-height:1.6; max-height:150px; overflow-y:auto; font-family:'IBM Plex Mono';}
  #validator-box .v-detail div{padding:4px 0; border-bottom:1px dashed #e6e8f0;}
  #validator-box .v-detail div:last-child{border-bottom:none;}
</style>
</head>
